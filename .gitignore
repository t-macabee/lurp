## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
## Get latest from https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# dotnet build output
bin/
obj/
artifacts/
.artifacts/

# IDE / tool caches
.vs/
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# Local tool configs / agent memory (present in this repo)
.claude/
CLAUDE.md
AGENTS.md
.tokensave/
.mimocode/
.repograph/
.agents/
.qodana/*
!.qodana/qodana.yaml

# Scratch / local-only (never committed)
prompt.txt
.tmp_test/

# Lurp index outputs (present: index.db + capsule-*.json + .trace-tmp)
index.db
*.db-wal
*.db-shm
capsule-*.json
.trace-tmp/

# Test / coverage results
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# Build logs
*.binlog
MSBuild_Logs/

# OS / editor
*.suo
*.user
*.userosscache
*.sln.docstates
