<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>2.0.0</Version>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>lurp</ToolCommandName>
    <PackageId>lurp</PackageId>
    <Authors>Tarik Džakić</Authors>
    <Description>Lurp — a Roslyn semantic map for .NET agents. Indexes a C# solution into SQLite via Roslyn and serves retrieval, semantic-diff, impact, and bounded context capsules to other software agents.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/t-macabee/lurp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>roslyn;c-sharp;code-analysis;sqlite;agents;MCP;semantic-search</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Map build-machine source paths out of the shipped PDB: a crash report
         (or the opt-in stack trace) must not expose C:\Users\... paths. -->
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lurp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Storage\**\*.cs" />
    <ProjectReference Include="Storage\Lurp.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" />
    <PackageReference Include="Microsoft.Build.Locator" />
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NET.StringTools" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="System.IO.Hashing" />
  </ItemGroup>

</Project>
