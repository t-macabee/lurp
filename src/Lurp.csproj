<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.1.0</Version>
    <DisableMSBuildAssemblyCopyCheck>true</DisableMSBuildAssemblyCopyCheck>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>lurp</ToolCommandName>
    <PackageId>lurp</PackageId>
    <Authors>Tarik Džakić</Authors>
    <Description>Lurp — a Roslyn semantic map for .NET agents. Indexes a C# solution into SQLite via Roslyn and serves retrieval, semantic-diff, impact, and bounded context capsules to other software agents.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/t-macabee/lurp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>roslyn;c-sharp;code-analysis;sqlite;agents;MCP;semantic-search</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lurp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Storage\**\*.cs" />
    <ProjectReference Include="Storage\Lurp.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.6.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.6.0" />   
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />   
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />   
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />   
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.10" />
    <PackageReference Include="Microsoft.Build.Tasks.Core" Version="18.8.2" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.8.2" ExcludeAssets="runtime" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" />
  </ItemGroup>

</Project>
