<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Oracle B needs Roslyn workspace APIs (Solution, SymbolFinder); the shared
       tree-snapshot project must not carry them, so this is a second project. -->
