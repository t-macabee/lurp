    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
  </ItemGroup>

  <!-- EdgeKind names the accepted/produced relation kinds; one source, not copies. -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Storage\Lurp.Storage.csproj" />
  </ItemGroup>

</Project>
