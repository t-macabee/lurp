<?xml version="1.0" encoding="utf-8"?>
<!-- Full suite, Slow tests included. CI, release, and user-run full-suite runs
     pass this file as the settings file (see CONTRIBUTING.md). A run that
     matches no test fails. -->
<RunSettings>
  <RunConfiguration>
    <TreatNoTestsAsError>true</TreatNoTestsAsError>
  </RunConfiguration>
  <LoggerRunSettings>
    <Loggers>
      <Logger friendlyName="console" enabled="True">
        <Configuration>
          <Verbosity>minimal</Verbosity>
        </Configuration>
      </Logger>
    </Loggers>
  </LoggerRunSettings>
</RunSettings>
